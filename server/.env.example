# Copy this file to .env in the repository root (see README) and fill in real values.
# Never commit the actual .env file.

# Port the Express server listens on (optional, defaults to 5000)
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_with_a_long_random_string

# API key for Groq (powers all AI features: task generation, breakdown, summary, risk analysis)
GROQ_API_KEY=your_groq_api_key

# Comma-separated list of allowed frontend origins for CORS + Socket.io
# Include both your local dev URL and your deployed frontend URL.
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# NOTE on password reset emails: utils/sendEmail.js currently only logs the
# reset link to the server console — it does not send a real email yet.
# For local testing, copy the reset link from the server terminal output.
# To send real emails in production, wire up a provider (e.g. nodemailer +
# SMTP, or a transactional email API) in utils/sendEmail.js and add its
# credentials here.