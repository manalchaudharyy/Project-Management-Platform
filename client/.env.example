# Copy this file to .env in the client/ folder and fill in real values
# before running `npm run build` for a production deploy.
# Leave both unset for local dev — Vite's dev server proxy (vite.config.js)
# handles routing "/api" and "/socket.io" to the local backend automatically.

# URL of your deployed backend API (include the "/api" suffix)
VITE_API_URL=https://your-backend.onrender.com/api

# URL of your deployed backend (no path suffix) — used for the Socket.io connection
VITE_SOCKET_URL=https://your-backend.onrender.com